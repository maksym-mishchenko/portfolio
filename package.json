{
  "name": "portfolio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "generate:blog-bundle": "node scripts/generate-blog-bundle.mjs",
    "prebuild": "npm run generate:blog-bundle",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "npm run generate:blog-bundle && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-dry-run": "npm run generate:blog-bundle && opennextjs-cloudflare build && wrangler deploy --dry-run",
    "deploy": "npm run generate:blog-bundle && opennextjs-cloudflare build && wrangler deploy",
    "upload": "npm run generate:blog-bundle && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "rm -rf .open-next && wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.11.0",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sugar-high": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.100.0"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
