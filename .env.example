# Portfolio environment variables
# Copy to .env.local for local development (never commit .env.local)

# Email sending via Resend API — contact form returns 503 if not set
RESEND_API_KEY=

# Recipient address for contact form emails
CONTACT_EMAIL=

# GitHub token for authenticated blog publish endpoint
GITHUB_TOKEN=

# Secret token for /api/blog/publish authentication
BLOG_PUBLISH_SECRET=

# Staging environment access secret
STAGING_SECRET=

# Auto-set by Next.js — do not set manually
# NODE_ENV=

# CI only — blog autopublish workflow secret (set in GitHub repo secrets, not .env)
# DEVLOG_AGENT_PASSWORD=
